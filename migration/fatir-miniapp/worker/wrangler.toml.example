# [vars]
# ALLOWED_ORIGIN = "https://kalonzoda-007.github.io"
# FRONTEND_URL = "https://kalonzoda-007.github.io/FATIRLOGIST/"
# N8N_BOOTSTRAP_URL and other URLs must be configured using wrangler secret put.
